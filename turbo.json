{
    "$schema": "node_modules/turbo/schema.json",

    "ui":"tui",

    "tasks": {
        "dev":{
            "cache":false,
            "persistent":true
        },

        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"],
        },

        "lint":{
            "dependsOn": ["^lint"]
        },

        "format":{
            "dependsOn": ["^format"]
        },

        "check-types": {
            "dependsOn": ["^check-types"]
        },
    }
}